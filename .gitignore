/dist/
# Instance data never belongs here: keep it in a separate private repo.
/instance/
*.ign
*.key
# Upgrade fixtures carry a throwaway age key that only decrypts test secrets.
!/internal/engine/testdata/upgrade/*/age.key
/internal/engine/testdata/upgrade/*/inhouse.db-*
*.env
.DS_Store
/console/node_modules/
/console/dist/
# The console build is embedded from here; only the placeholder is tracked.
/internal/console/dist/*
!/internal/console/dist/.gitkeep
